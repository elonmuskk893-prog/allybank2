# Public browser configuration (safe to expose)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only database configuration (never prefix the service key with VITE_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional email provider fallback. Email can also be configured in Admin Settings.
RESEND_API_KEY=
# MAILERSEND_API_KEY=
EMAIL_FROM_NAME=Online Banking
EMAIL_FROM_ADDRESS=

# Optional scheduled endpoint secret. Generate a unique random value.
CRON_SECRET=

# Local development only. Never enable this in Vercel Production or Preview.
ALLOW_MOCK_DB=false
